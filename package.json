{
  "name": "pharmaceutical-management-system-root",
  "version": "1.0.0",
  "private": true,
  "description": "Pharmaceutical Management System (PMS) Monorepo",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
